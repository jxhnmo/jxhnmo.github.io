{
  "homepage": "https://jxhnmo.github.io",
  "name": "johns-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-switch": "^1.2.6",
    "classnames": "^2.5.1",
    "next": "^16.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "_packageManagerComment": "npm is the only package manager here, and package-lock.json is the only lockfile. The repo previously tracked all three of package-lock.json, yarn.lock, and pnpm-lock.yaml; they drifted, and pnpm-lock.yaml sat five weeks stale still resolving a dependency that had been removed. Declaring it here keeps a stray `yarn add` from reintroducing a second lockfile. Recover the deleted ones with `git show <sha>:yarn.lock` if ever needed.",
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "rm -rf out/og-preview",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images": "python3 scripts/optimize-images.py",
    "og": "node scripts/generate-og.mjs && python3 scripts/optimize-images.py",
    "og:watch": "node --watch-path=scripts/generate-og.mjs --watch-path=src/content/routes.json scripts/generate-og.mjs",
    "verify:assets": "python3 scripts/optimize-images.py --check && node scripts/generate-og.mjs --check",
    "check": "npm run verify:assets && npm run format:check && npm run typecheck && npm run lint && npm run build",
    "predeploy": "rm -rf out/og-preview",
    "deploy": "gh-pages -d out"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "gh-pages": "^6.3.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.14"
  }
}
